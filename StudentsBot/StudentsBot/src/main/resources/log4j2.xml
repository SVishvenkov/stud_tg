<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">
    <Appenders>
        <!-- Консольный вывод -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <!-- Основной файловый лог -->
        <RollingFile name="MainLog"
                     fileName="C:Users/Serge/Documents/Bot/logs/bot.log"
                     filePattern="logs/bot-%d{yyyy-MM-dd}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
        </RollingFile>

        <!-- Лог доступа к файлам -->
        <RollingFile name="FileAccessLog"
                     fileName="C:Users/Serge/Documents/Bot/logs/file_access.log"
                     filePattern="logs/file_access-%d{yyyy-MM-dd}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- Корневой логгер -->
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="MainLog"/>
        </Root>

        <!-- Специализированные логгеры -->
        <Logger name="USER_ACTIONS" level="info" additivity="false">
            <AppenderRef ref="MainLog"/>
        </Logger>

        <Logger name="AUTH_LOGGER" level="info" additivity="false">
            <AppenderRef ref="MainLog"/>
        </Logger>

        <Logger name="FILE_ACCESS_LOGGER" level="debug" additivity="false">
            <AppenderRef ref="FileAccessLog"/>
        </Logger>

        <Logger name="NAVIGATION_LOGGER" level="info" additivity="false">
            <AppenderRef ref="MainLog"/>
        </Logger>
    </Loggers>
</Configuration>